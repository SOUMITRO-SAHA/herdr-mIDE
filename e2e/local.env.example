# Optional machine-local overrides for e2e automation.
# Copy to e2e/local.env (gitignored) and uncomment what you need.
#
# export E2E_HERDR_BIN="/Applications/Herdr.app/Contents/MacOS/Herdr"
# HERDR_APP_HOME alone does NOT isolate spaces — use the full profile
# (just setup-herdr-dev / scripts/herdr-dev-profile.sh). Optional overrides:
# export HERDR_DEV_ROOT="$HOME/.config/herdr-dev"
# export HERDR_DEV_HC_SESSION="herdr-mide-dev"
# export E2E_REPO=""          # workspace folder for space.new (default: repo root)
# export E2E_SPACE_ID=""      # reuse an existing dev space instead of space.new
# export E2E_REF_WIDTH=2940   # screenshot calibration width (pointer mapping)
# export E2E_REF_HEIGHT=1846  # screenshot calibration height